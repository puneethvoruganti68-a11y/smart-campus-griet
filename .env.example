# Server-side persistence (Turso/libSQL)
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=replace_with_a_turso_auth_token

# Required in production: generate a long random value and keep it server-side.
SESSION_SECRET=replace_with_a_long_random_secret

# Central administration credentials. Never expose these as NEXT_PUBLIC variables.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_DISPLAY_NAME=GRIET Administration

# Optional one-record staff setup for development or deployment bootstrap.
# Do not fill these with invented IDs; use the real staff details when supplied.
# DEV_STAFF_ID=
# DEV_STAFF_NAME=
# DEV_STAFF_DEPARTMENT_ID=dept_electrical

# Optional AI configuration. The deterministic classifier works without a key.
GEMINI_API_KEY=
MOCK_AI=true

# Create ADMIN_PASSWORD_HASH without putting a password in source code:
# node -e "console.log(require('bcryptjs').hashSync(process.env.ADMIN_PASSWORD, 12))"
